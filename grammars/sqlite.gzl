    CASE_, CAST_, CHECK_, CLOSE_PAR, COLLATE_, COLUMN_, COMMA, COMMIT_,
    CONFLICT_, CONSTRAINT_, CREATE_, CROSS_, CURRENT_, CURRENT_DATE_, CURRENT_TIMESTAMP_, CURRENT_TIME_,
    DATABASE_, DEFAULT_, DEFERRABLE_, DEFERRED_, DELETE_, DESC_, DETACH_, DISTINCT_,
    DIV, DOT, DO_, DROP_, EACH_, ELSE_, END_, EQ,
    ESCAPE_, EXCEPT_, EXCLUDE_, EXCLUSIVE_, EXISTS_, EXPLAIN_, FAIL_, FALSE_,
    FILTER_, FIRST_, FOLLOWING_, FOREIGN_, FOR_, FROM_, FULL_, GENERATED_,
    GLOB_, GROUPS_, GROUP_, GT, GT2, GT_EQ, HAVING_, IDENTIFIER,
    IF_, IGNORE_, IMMEDIATE_, INDEXED_, INDEX_, INITIALLY_, INNER_, INSERT_,
    INSTEAD_, INTERSECT_, INTO_, IN_, ISNULL_, IS_, JOIN_, JPTR,
    JPTR2, KEY_, LAST_, LEFT_, LIKE_, LIMIT_, LT, LT2,
    LT_EQ, MATCH_, MATERIALIZED_, MINUS, MOD, NATURAL_, NOTHING_, NOTNULL_,
