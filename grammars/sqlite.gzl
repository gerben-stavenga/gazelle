column_name_list = OPEN_PAR column_name __antlr_column_name_list_group_177 * CLOSE_PAR => alt_1;

qualified_table_name = __antlr_qualified_table_name_group_178 ? table_name __antlr_qualified_table_name_group_179 ? __antlr_qualified_table_name_group_180 ? => alt_1;

