    OF_, ON_, OPEN_PAR, ORDER_, OR_, OTHERS_, OUTER_, OVER_,
    PARTITION_, PIPE, PIPE2, PLAN_, PLUS, PRAGMA_, PRECEDING_, PRIMARY_,
