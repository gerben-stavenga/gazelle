create_virtual_table_stmt = CREATE_ VIRTUAL_ TABLE_ __antlr_create_virtual_table_stmt_group_73 ? __antlr_create_virtual_table_stmt_group_74 ? table_name USING_ module_name __antlr_create_virtual_table_stmt_group_76 ? => alt_1;

with_clause = WITH_ RECURSIVE_ ? common_table_expression __antlr_with_clause_group_77 * => alt_1;

common_table_expression = cte_table_name AS_ __antlr_common_table_expression_group_78 ? OPEN_PAR select_stmt CLOSE_PAR => alt_1;

cte_table_name = table_name __antlr_cte_table_name_group_80 ? => alt_1;

delete_stmt = with_clause ? DELETE_ FROM_ qualified_table_name __antlr_delete_stmt_group_81 ? returning_clause ? order_clause ? limit_clause ? => alt_1;

detach_stmt = DETACH_ DATABASE_ ? schema_name => alt_1;

drop_stmt = DROP_ __antlr_drop_stmt_group_82 __antlr_drop_stmt_group_83 ? __antlr_drop_stmt_group_84 ? any_name => alt_1;

expr = expr_or => alt_1;

expr_or = expr_and __antlr_expr_or_group_85 * => alt_1;

expr_and = expr_not __antlr_expr_and_group_86 * => alt_1;

expr_not = NOT_ * expr_binary => alt_1;

expr_binary = expr_comparison __antlr_expr_binary_group_99 * => alt_1;

expr_comparison = expr_bitwise __antlr_expr_comparison_group_101 * => alt_1;

