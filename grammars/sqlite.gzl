expr_recursive = function_name OPEN_PAR __antlr_expr_recursive_group_115 ? CLOSE_PAR percentile_clause ? filter_clause ? over_clause ? => alt_1
    | OPEN_PAR expr __antlr_expr_recursive_group_116 * CLOSE_PAR => alt_2
    | CAST_ OPEN_PAR expr AS_ type_name CLOSE_PAR => alt_3
    | CASE_ expr ? __antlr_expr_recursive_group_117 + __antlr_expr_recursive_group_118 ? END_ => alt_4;

