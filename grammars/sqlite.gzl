join_clause = table_or_subquery __antlr_join_clause_group_149 * => alt_1;

select_core = SELECT_ __antlr_select_core_group_150 ? result_column __antlr_select_core_group_151 * __antlr_select_core_group_152 ? __antlr_select_core_group_153 ? __antlr_select_core_group_156 ? __antlr_select_core_group_158 ? => alt_1
