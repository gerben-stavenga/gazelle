returning_clause = RETURNING_ __antlr_returning_clause_group_131 __antlr_returning_clause_group_134 * => alt_1;

upsert_clause = ON_ CONFLICT_ __antlr_upsert_clause_group_137 ? DO_ __antlr_upsert_clause_group_142 => alt_1;

pragma_stmt = PRAGMA_ __antlr_pragma_stmt_group_143 ? pragma_name __antlr_pragma_stmt_group_144 ? => alt_1;

