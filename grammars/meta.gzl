start grammar_def;
terminals {
    IDENT: _,
    NUM: _,
    REGEX: _,
    MODIFIER: _,
    KW_START,
    KW_TERMINALS,
    KW_EXPECT,
    KW_AS,

    UNDERSCORE,
    LBRACE,
    RBRACE,
    LPAREN,
    RPAREN,
    COLON,
    COMMA,
    EQ,
    PIPE,
    SEMI,
    FAT_ARROW,
    QUESTION,
    STAR,
    PLUS,
    PERCENT
}

grammar_def =
    KW_START IDENT SEMI
    expect_decl*
    KW_TERMINALS LBRACE (terminal_item % COMMA) RBRACE
    rule+
    => grammar_def;

expect_decl = KW_EXPECT NUM IDENT SEMI => expect_decl;

terminal_item = MODIFIER? IDENT type_annot? regex_annot? => terminal_item;

type_annot = COLON UNDERSCORE => type_annot;

regex_annot = EQ REGEX => regex_annot;

rule = IDENT EQ (alt % PIPE) SEMI => rule;

alt = term+ variant => alt;

variant = FAT_ARROW IDENT => variant;

term = LPAREN IDENT PERCENT IDENT RPAREN => sym_sep
     | LPAREN IDENT PERCENT IDENT RPAREN KW_AS IDENT => sym_sep_as
     | IDENT QUESTION => sym_opt
     | IDENT STAR => sym_star
     | IDENT STAR KW_AS IDENT => sym_star_as
     | IDENT PLUS => sym_plus
     | IDENT PLUS KW_AS IDENT => sym_plus_as
     | IDENT => sym_plain
     | UNDERSCORE => sym_empty;
